--- a/dlls/win32u/vulkan.c
+++ b/dlls/win32u/vulkan.c
@@ -920,6 +920,23 @@
 
     /* For host visible memory, we try to use VK_EXT_external_memory_host on wow64 to ensure that mapped pointer is 32-bit. */
     mem_flags = physical_device->memory_properties.memoryTypes[alloc_info->memoryTypeIndex].propertyFlags;
+    /* FrostBox: a whole placed map needs an allocation-sized aligned range.
+     * Keep imported/exported/dedicated allocation contracts unchanged. */
+    if (physical_device->map_placed_align && (mem_flags & VK_MEMORY_PROPERTY_HOST_VISIBLE_BIT))
+    {
+        const VkBaseInStructure *chain;
+        BOOL ordinary = TRUE;
+        VkDeviceSize mask = physical_device->map_placed_align - 1;
+        for (chain = alloc_info->pNext; chain; chain = chain->pNext)
+            if (chain->sType != VK_STRUCTURE_TYPE_MEMORY_ALLOCATE_FLAGS_INFO &&
+                chain->sType != VK_STRUCTURE_TYPE_MEMORY_PRIORITY_ALLOCATE_INFO_EXT) ordinary = FALSE;
+        if (ordinary)
+        {
+            if (alloc_info->allocationSize > ~(VkDeviceSize)0 - mask) return VK_ERROR_OUT_OF_DEVICE_MEMORY;
+            TRACE( "FrostBox WoW64 placed allocation %s alignment %u\n", wine_dbgstr_longlong(alloc_info->allocationSize), physical_device->map_placed_align );
+            alloc_info->allocationSize = (alloc_info->allocationSize + mask) & ~mask;
+        }
+    }
     if (physical_device->external_memory_align && (mem_flags & VK_MEMORY_PROPERTY_HOST_VISIBLE_BIT) && !pointer_info &&
         (res = allocate_external_host_memory( device, alloc_info, mem_flags, &host_pointer_info )))
         return res;
